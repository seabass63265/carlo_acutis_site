# Copy to .env.local and fill in. Never commit real values.

# ── Bank of America Gateway (Cybersource REST API) ──────────────────────
# "test" or "production". Defaults to "test" if unset — production charges
# require explicitly setting this to "production" alongside production
# credentials below.
BOFA_ENVIRONMENT=test

# Extra, deliberate opt-in required (in addition to BOFA_ENVIRONMENT=production)
# before any real charge can be attempted. Leave unset/false until the DCE
# test checklist has been fully run and passed. This is a safety interlock,
# not a feature flag — do not set it to unblock testing.
BOFA_PRODUCTION_READY=false

# From the Business Center's Key Management area, "REST – Shared Secret"
# key type. Use TEST-environment credentials when BOFA_ENVIRONMENT=test,
# and PRODUCTION credentials only when BOFA_ENVIRONMENT=production — these
# are separate credential sets from separate dashboards/accounts.
BOFA_MERCHANT_ID=
BOFA_KEY_ID=
BOFA_SHARED_SECRET=

# Exact https:// origin of this site (no trailing slash/path). Cybersource's
# docs explicitly require this to be hard-coded server-side, never taken
# from the incoming request. http://localhost:PORT is accepted only for
# local dev.
DONATE_SITE_ORIGIN=http://localhost:3000

# ── Private checkout gate (controlled live-check period) ────────────────
# A long random secret. Until this is set, the donation form always shows
# "coming soon" to everyone — there is no default/bypass value. Generate
# with: openssl rand -base64 24
# Visiting /api/donate/preview-access?token=<this value> grants the
# visiting browser 24h of access via an httpOnly cookie. Share that full
# URL privately (never publicly) with whoever is running the live check.
# To open donations to the public later, change OneTimeDonation() in
# app/[locale]/donate/page.tsx to stop gating on hasDonationAccess() — see
# delivery notes for the exact one-line change.
DONATE_PRIVATE_ACCESS_TOKEN=

# ── Donation storage / idempotency / rate limiting (Upstash Redis) ──────
# Required for the donation routes to run at all.
#
# If provisioned via Upstash directly, set these two:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
#
# If provisioned via Vercel's Storage tab (Marketplace Upstash integration),
# Vercel names them differently — set these two instead (code falls back to
# them automatically if the UPSTASH_* pair above isn't set). Use
# KV_REST_API_TOKEN (read/write), NOT KV_REST_API_READ_ONLY_TOKEN — this
# store writes idempotency reservations, donation records, and rate-limit
# counters, not just reads.
#   KV_REST_API_URL=
#   KV_REST_API_TOKEN=
# Vercel also generates KV_REST_API_READ_ONLY_TOKEN, KV_URL, and REDIS_URL
# for this integration — none of those are used by this code.

# ── Email (already used by the contact form; reused for donation receipts) ─
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL must be an address on a domain you've verified in the
# Resend dashboard (SPF/DKIM configured there). If this is left unset, the
# code falls back to Resend's shared onboarding@resend.dev sender, which
# works for low-volume testing but has poor deliverability/reputation for
# receipts going out to many different donor inboxes — do not use it in
# production.
CONTACT_FROM_EMAIL=
